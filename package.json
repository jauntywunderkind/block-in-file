{
  "name": "block-in-file",
  "version": "1.0.1",
  "description": "Insert & update blocks of text in files",
  "keywords": [
    "block",
    "file",
    "insert",
    "text"
  ],
  "license": "ISC",
  "author": "",
  "bin": {
    "block-in-file": "./dist/block-in-file.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./toolkit": {
      "types": "./dist/toolkit.d.mts",
      "import": "./dist/toolkit.mjs"
    }
  },
  "scripts": {
    "build:bundle": "tsdown",
    "build:standalone": "tsdown --config tsdown.standalone.config.ts",
    "build": "concurrently \"pnpm:build:*\"",
    "prepack": "pnpm build",
    "check:ts": "tsgo --noEmit",
    "check:lint": "oxlint --ignore-path .oxfmtignore",
    "check:fmt": "oxfmt --check --ignore-path .oxfmtignore",
    "fix:lint": "oxlint --fix --ignore-path .oxfmtignore",
    "fix:fmt": "oxfmt --ignore-path .oxfmtignore",
    "check": "concurrently \"pnpm:check:*\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@gunshi/plugin": "^0.37.3",
    "args-tokenizer": "^0.3.0",
    "gunshi": "^0.37.3",
    "tinyexec": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^10.0.5",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@10.28.2"
}
